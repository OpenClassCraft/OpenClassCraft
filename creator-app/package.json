{
  "name": "openclasscraft-creator",
  "version": "0.1.0",
  "private": true,
  "author": "OpenClassCraft Contributors",
  "license": "GPL-2.0-only",
  "desktopName": "org.openclasscraft.creator",
  "description": "A visual creator for safe OpenClassCraft classroom mods.",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "package:linux": "electron-builder --linux AppImage",
    "package:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "org.openclasscraft.creator",
    "productName": "OpenClassCraft Creator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json",
      "LICENSE"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "../games/luanti_edu/menu/icon.png",
      "category": "Education",
      "syncDesktopName": true,
      "artifactName": "OpenClassCraft-Creator-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "../misc/openclasscraft.ico",
      "artifactName": "OpenClassCraft-Creator-${version}-windows-${arch}.${ext}"
    }
  },
  "dependencies": {
    "blockly": "^12.2.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
